{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devdox",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",

  // no devdox.workers.dev — the wildcard route is the only entrypoint
  "workers_dev": false,
  "routes": [{ "pattern": "*.example.com/*", "zone_name": "example.com" }],

  "vars": { "BASE_DOMAIN": "example.com" },

  // id is filled in by `devdox init`
  "kv_namespaces": [{ "binding": "SITES", "id": "__KV_NAMESPACE_ID__" }],

  "observability": { "enabled": true }
}
