#!/usr/bin/env node
// devdox — publish static pages to <random>.example.com
// zero deps, node >= 18 (built-in fetch)

import { createHash, randomBytes } from 'node:crypto'
import { mkdirSync, readdirSync, readFileSync, statSync, writeFileSync, existsSync } from 'node:fs'
import { homedir } from 'node:os'
import { basename, extname, join, relative, resolve, sep } from 'node:path'

const CONFIG_DIR = join(process.env.XDG_CONFIG_HOME || join(homedir(), '.config'), 'devdox')
const CONFIG_PATH = join(CONFIG_DIR, 'config.json')
const API = 'https://api.cloudflare.com/client/v4'

const MAX_VALUE = 25 * 1024 * 1024 // KV per-value cap
const MAX_BULK_BYTES = 90 * 1024 * 1024 // API cap is 100MB, leave headroom
const MAX_BULK_KEYS = 10000

const die = (msg) => {
  console.error(`devdox: ${msg}`)
  process.exit(1)
}

// ---------- config ----------

function loadConfig() {
  let cfg = {}
  if (existsSync(CONFIG_PATH)) {
    try {
      cfg = JSON.parse(readFileSync(CONFIG_PATH, 'utf8'))
    } catch (e) {
      die(`config at ${CONFIG_PATH} is not valid JSON: ${e.message}`)
    }
  }
  if (process.env.CLOUDFLARE_API_TOKEN) cfg.apiToken = process.env.CLOUDFLARE_API_TOKEN
  if (process.env.DEVDOX_DOMAIN) cfg.domain = process.env.DEVDOX_DOMAIN
  return cfg
}

function saveConfig(cfg) {
  mkdirSync(CONFIG_DIR, { recursive: true, mode: 0o700 })
  writeFileSync(CONFIG_PATH, JSON.stringify(cfg, null, 2) + '\n', { mode: 0o600 })
}

function need(cfg, ...keys) {
  for (const k of keys) {
    if (!cfg[k]) die(`missing "${k}" — run \`devdox init\` first (or set it in ${CONFIG_PATH})`)
  }
}

// ---------- cloudflare api ----------

// returns null instead of exiting when init.tolerate403 is set and the token lacks the permission
async function cf(cfg, path, init = {}) {
  const { tolerate403, ...fetchInit } = init
  const res = await fetch(API + path, {
    ...fetchInit,
    headers: {
      authorization: `Bearer ${cfg.apiToken}`,
      ...(fetchInit.body && !fetchInit.headers ? { 'content-type': 'application/json' } : {}),
      ...fetchInit.headers,
    },
  })
  const text = await res.text()
  let body
  try {
    body = JSON.parse(text)
  } catch {
    die(`API ${res.status} on ${path}: ${text.slice(0, 300)}`)
  }
  if (!body.success) {
    const errs = (body.errors || []).map((e) => `${e.code} ${e.message}`).join('; ')
    if (tolerate403 && (res.status === 403 || (body.errors || []).some((e) => e.code === 10000))) return null
    let hint = ''
    if ((body.errors || []).some((e) => e.code === 10000)) {
      hint = `\n  the token is missing a permission for this call — it needs ${permissionFor(path)}.` +
        `\n  edit it at https://dash.cloudflare.com/profile/api-tokens, then re-run the same command.`
    }
    die(`API ${res.status} on ${path}: ${errs || text.slice(0, 300)}${hint}`)
  }
  return body
}

function permissionFor(path) {
  if (path.includes('/dns_records')) return 'Zone > DNS > Edit'
  if (path.includes('/storage/kv/')) return 'Account > Workers KV Storage > Edit'
  if (path.startsWith('/zones?')) return 'Zone > Zone > Read'
  return 'a broader scope'
}

// ---------- helpers ----------

const slugRe = /^[a-z0-9][a-z0-9-]{0,61}[a-z0-9]$/

function newSlug() {
  return randomBytes(8).toString('hex') // 64 bits, 16 chars
}

function collectFiles(target) {
  const st = statSync(target)
  if (st.isFile()) {
    const ext = extname(target).toLowerCase()
    // a lone page always becomes the site root
    const path = ext === '.html' || ext === '.htm' || ext === '.md' ? '/index.html' : '/' + basename(target)
    return [{ path, abs: resolve(target), size: st.size }]
  }
  const out = []
  const walk = (dir) => {
    for (const entry of readdirSync(dir, { withFileTypes: true })) {
      if (entry.name.startsWith('.')) continue
      const abs = join(dir, entry.name)
      if (entry.isDirectory()) walk(abs)
      else if (entry.isFile()) {
        out.push({
          path: '/' + relative(target, abs).split(sep).join('/'),
          abs,
          size: statSync(abs).size,
        })
      }
    }
  }
  walk(resolve(target))
  if (!out.length) die(`no files under ${target}`)
  if (!out.some((f) => f.path === '/index.html')) {
    console.error('devdox: warning — no index.html at the root, "/" will 404')
  }
  return out
}

const fmtBytes = (n) =>
  n < 1024 ? `${n} B` : n < 1024 * 1024 ? `${(n / 1024).toFixed(1)} KB` : `${(n / 1024 / 1024).toFixed(1)} MB`

async function bulkPut(cfg, pairs) {
  // chunk so no request blows the 100MB / 10k-key ceiling
  let batch = []
  let bytes = 0
  const flush = async () => {
    if (!batch.length) return
    await cf(cfg, `/accounts/${cfg.accountId}/storage/kv/namespaces/${cfg.namespaceId}/bulk`, {
      method: 'PUT',
      body: JSON.stringify(batch),
    })
    batch = []
    bytes = 0
  }
  for (const p of pairs) {
    const size = p.value.length
    if (batch.length >= MAX_BULK_KEYS || bytes + size > MAX_BULK_BYTES) await flush()
    batch.push(p)
    bytes += size
  }
  await flush()
}

async function listKeys(cfg, prefix) {
  const keys = []
  let cursor = ''
  do {
    const q = new URLSearchParams({ prefix, limit: '1000' })
    if (cursor) q.set('cursor', cursor)
    const body = await cf(cfg, `/accounts/${cfg.accountId}/storage/kv/namespaces/${cfg.namespaceId}/keys?${q}`)
    keys.push(...body.result)
    cursor = body.result_info?.cursor || ''
  } while (cursor)
  return keys
}

// ---------- commands ----------

async function cmdInit(argv) {
  const cfg = loadConfig()
  const arg = (name, fallback) => {
    const i = argv.indexOf('--' + name)
    return i >= 0 ? argv[i + 1] : fallback
  }

  cfg.domain = arg('domain', cfg.domain || 'example.com')
  cfg.apiToken = arg('token', cfg.apiToken)
  if (!cfg.apiToken) {
    die(
      'no API token. Create one at https://dash.cloudflare.com/profile/api-tokens with permissions:\n' +
        '  Account > Workers KV Storage > Edit\n' +
        '  Account > Workers Scripts   > Edit\n' +
        '  Zone    > DNS               > Edit\n' +
        '  Zone    > Zone              > Read\n' +
        'then: devdox init --token <TOKEN>   (or export CLOUDFLARE_API_TOKEN=...)'
    )
  }

  // zone + account
  const zones = await cf(cfg, `/zones?name=${encodeURIComponent(cfg.domain)}`)
  if (!zones.result.length) die(`zone ${cfg.domain} not found on this account`)
  cfg.zoneId = zones.result[0].id
  cfg.accountId = zones.result[0].account.id
  console.log(`zone     ${cfg.domain} ${cfg.zoneId}`)
  console.log(`account  ${cfg.accountId}`)
  saveConfig(cfg) // checkpoint — a later step failing shouldn't lose this

  // kv namespace (reuse if it already exists)
  const title = arg('namespace', 'devdox-sites')
  const ns = await cf(cfg, `/accounts/${cfg.accountId}/storage/kv/namespaces?per_page=100`)
  const found = ns.result.find((n) => n.title === title)
  if (found) {
    cfg.namespaceId = found.id
    console.log(`kv       ${title} ${cfg.namespaceId} (existing)`)
  } else {
    const made = await cf(cfg, `/accounts/${cfg.accountId}/storage/kv/namespaces`, {
      method: 'POST',
      body: JSON.stringify({ title }),
    })
    cfg.namespaceId = made.result.id
    console.log(`kv       ${title} ${cfg.namespaceId} (created)`)
  }
  saveConfig(cfg)

  // wildcard record. AAAA 100:: proxied is the documented placeholder for worker-only hostnames
  const manualDns = () =>
    console.log(
      `\ndns      NOT set up — create it by hand at\n` +
        `         https://dash.cloudflare.com/?to=/:account/${cfg.domain}/dns\n` +
        `         Type AAAA   Name *   IPv6 100::   Proxy status: Proxied\n` +
        `         (needs Zone > DNS > Edit on the token to automate; account-owned\n` +
        `          tokens cannot carry zone permissions at all)`
    )

  if (argv.includes('--skip-dns')) {
    manualDns()
  } else {
    const recs = await cf(cfg, `/zones/${cfg.zoneId}/dns_records?name=${encodeURIComponent('*.' + cfg.domain)}`, {
      tolerate403: true,
    })
    if (recs === null) {
      manualDns()
    } else if (recs.result.length) {
      console.log(`dns      *.${cfg.domain} ${recs.result[0].type} (existing)`)
    } else {
      const made = await cf(cfg, `/zones/${cfg.zoneId}/dns_records`, {
        method: 'POST',
        tolerate403: true,
        body: JSON.stringify({
          type: 'AAAA',
          name: '*',
          content: '100::',
          proxied: true,
          comment: 'devdox — wildcard for worker route',
        }),
      })
      if (made === null) manualDns()
      else console.log(`dns      *.${cfg.domain} AAAA 100:: proxied (created)`)
    }
  }

  saveConfig(cfg)
  console.log(`config   ${CONFIG_PATH}`)

  const repo = resolve(join(import.meta.dirname, '..'))
  const wranglerPath = join(repo, 'wrangler.jsonc')
  if (existsSync(wranglerPath)) {
    const before = readFileSync(wranglerPath, 'utf8')
    const after = before
      .replace(/"id":\s*"[^"]*"/, `"id": "${cfg.namespaceId}"`)
      .replaceAll('example.com', cfg.domain)
    if (after !== before) {
      writeFileSync(wranglerPath, after)
      console.log(`wrangler ${wranglerPath} updated`)
    }
  }

  console.log(`\nnext:\n  cd ${repo} && npx wrangler deploy`)
}

async function cmdPublish(argv) {
  const cfg = loadConfig()
  need(cfg, 'apiToken', 'accountId', 'namespaceId', 'domain')

  let target = null
  let slug = null
  let ttlDays = null
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i]
    if (a === '--slug') slug = argv[++i]
    else if (a === '--ttl') ttlDays = Number(argv[++i])
    else if (a.startsWith('-')) die(`unknown flag ${a}`)
    else if (target === null) target = a
    else die('publish takes one file or directory')
  }
  if (!target) die('usage: devdox publish <file|dir> [--slug NAME] [--ttl DAYS]')
  if (!existsSync(target)) die(`no such path: ${target}`)

  if (slug) {
    slug = slug.toLowerCase()
    if (!slugRe.test(slug)) die('--slug must be lowercase letters, digits and hyphens')
  } else {
    slug = newSlug()
  }

  const ttl = ttlDays ? Math.max(60, Math.round(ttlDays * 86400)) : null
  const files = collectFiles(target)

  const pairs = []
  let total = 0
  for (const f of files) {
    if (f.size > MAX_VALUE) die(`${f.path} is ${fmtBytes(f.size)}, over the 25 MB per-file KV limit`)
    const buf = readFileSync(f.abs)
    total += buf.length
    pairs.push({
      key: `${slug}:${f.path}`,
      value: buf.toString('base64'),
      base64: true,
      metadata: { etag: `"${createHash('sha256').update(buf).digest('hex').slice(0, 32)}"` },
      ...(ttl ? { expiration_ttl: ttl } : {}),
    })
  }

  pairs.push({
    key: `__index:${slug}`,
    value: '',
    metadata: {
      created: new Date().toISOString(),
      files: files.length,
      bytes: total,
      src: basename(resolve(target)),
      ...(ttl ? { expires: new Date(Date.now() + ttl * 1000).toISOString() } : {}),
    },
    ...(ttl ? { expiration_ttl: ttl } : {}),
  })

  await bulkPut(cfg, pairs)

  const url = `https://${slug}.${cfg.domain}/`
  console.log(url)
  console.error(
    `  ${files.length} file${files.length === 1 ? '' : 's'}, ${fmtBytes(total)}` +
      (ttl ? `, expires in ${ttlDays} day${ttlDays === 1 ? '' : 's'}` : '')
  )
}

async function cmdList() {
  const cfg = loadConfig()
  need(cfg, 'apiToken', 'accountId', 'namespaceId', 'domain')
  const keys = await listKeys(cfg, '__index:')
  if (!keys.length) return console.log('nothing published yet')
  keys.sort((a, b) => (b.metadata?.created || '').localeCompare(a.metadata?.created || ''))
  for (const k of keys) {
    const slug = k.name.slice('__index:'.length)
    const m = k.metadata || {}
    const when = m.created ? m.created.slice(0, 16).replace('T', ' ') : '?'
    const size = m.bytes != null ? fmtBytes(m.bytes) : '?'
    console.log(
      `${when}  ${String(m.files ?? '?').padStart(3)} files  ${size.padStart(8)}  ` +
        `https://${slug}.${cfg.domain}/  ${m.src || ''}${m.expires ? `  (expires ${m.expires.slice(0, 10)})` : ''}`
    )
  }
}

async function cmdRm(argv) {
  const cfg = loadConfig()
  need(cfg, 'apiToken', 'accountId', 'namespaceId', 'domain')
  const slug = argv[0]
  if (!slug) die('usage: devdox rm <slug>')
  const keys = [...(await listKeys(cfg, `${slug}:`)), ...(await listKeys(cfg, `__index:${slug}`))]
  const names = keys.map((k) => k.name).filter((n) => n === `__index:${slug}` || n.startsWith(`${slug}:`))
  if (!names.length) die(`no site with slug ${slug}`)
  await cf(cfg, `/accounts/${cfg.accountId}/storage/kv/namespaces/${cfg.namespaceId}/bulk/delete`, {
    method: 'POST',
    body: JSON.stringify(names),
  })
  console.log(`removed ${slug} (${names.length - 1} files)`)
}

function usage() {
  console.log(`devdox — publish static pages to *.example.com

  devdox publish <file|dir> [--slug NAME] [--ttl DAYS]
  devdox list
  devdox rm <slug>
  devdox init [--token TOKEN] [--domain example.com] [--skip-dns]

A single .html file becomes the site root. A directory is uploaded as-is;
index.html at its root becomes "/". Slugs are 16 random hex chars unless
--slug is given. Pages are public to anyone with the URL and sent with
X-Robots-Tag: noindex.`)
}

const [cmd, ...rest] = process.argv.slice(2)
const run = {
  publish: cmdPublish,
  p: cmdPublish,
  list: cmdList,
  ls: cmdList,
  rm: cmdRm,
  delete: cmdRm,
  init: cmdInit,
}[cmd]

if (!run) {
  usage()
  process.exit(cmd ? 1 : 0)
}
run(rest).catch((e) => die(e.message))
